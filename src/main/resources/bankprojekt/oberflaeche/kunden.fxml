<?xml version="1.0" encoding="UTF-8"?>

<!-- Kundenansicht: Suche und Statusfilter, Tabelle aller Kunden,
     Anlegen, Bearbeiten und Deaktivieren/Aktivieren. -->

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="bankprojekt.oberflaeche.KundenController"
      stylesheets="@verwaltung.css"
      styleClass="arbeitsbereich">

    <Label text="Kunden" styleClass="ueberschrift"/>

    <HBox styleClass="werkzeugleiste">
        <TextField fx:id="suche" promptText="Suche nach Name oder Kundennummer" prefWidth="280"/>
        <ComboBox fx:id="statusFilter" prefWidth="150"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Neuer Kunde" styleClass="primaer" onAction="#neuerKunde"/>
        <Button fx:id="bearbeitenKnopf" text="Bearbeiten" onAction="#bearbeiten"/>
        <Button fx:id="statusKnopf" text="Deaktivieren" onAction="#statusWechseln"/>
    </HBox>

    <TableView fx:id="tabelle" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="nummerSpalte" text="Kundennummer" prefWidth="110"/>
            <TableColumn fx:id="nameSpalte" text="Name" prefWidth="200"/>
            <TableColumn fx:id="geburtsdatumSpalte" text="Geburtsdatum" prefWidth="110"/>
            <TableColumn fx:id="emailSpalte" text="E-Mail" prefWidth="220"/>
            <TableColumn fx:id="telefonSpalte" text="Telefon" prefWidth="140"/>
            <TableColumn fx:id="kontenSpalte" text="Konten" prefWidth="70"/>
            <TableColumn fx:id="statusSpalte" text="Status" prefWidth="100"/>
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
        </columnResizePolicy>
        <placeholder>
            <Label text="Keine Kunden gefunden."/>
        </placeholder>
    </TableView>

    <Label fx:id="anzahl" styleClass="fusszeile"/>
</VBox>

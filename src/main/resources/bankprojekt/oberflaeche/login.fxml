<?xml version="1.0" encoding="UTF-8"?>

<!-- Anmeldemaske der Bankverwaltung: Benutzername und Passwort,
     Fehlermeldungen erscheinen direkt unter den Feldern. -->

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="bankprojekt.oberflaeche.LoginController"
           stylesheets="@verwaltung.css"
           styleClass="anmeldung"
           prefWidth="520" prefHeight="460">

    <VBox styleClass="karte" spacing="8" maxWidth="360" maxHeight="-Infinity">
        <padding>
            <Insets top="28" right="32" bottom="28" left="32"/>
        </padding>

        <Label text="Bankverwaltung" styleClass="titel"/>
        <Label text="Bitte melden Sie sich mit Ihrem Mitarbeiterzugang an." styleClass="untertitel"
               wrapText="true"/>

        <Label text="Benutzername" styleClass="feldname">
            <VBox.margin>
                <Insets top="14"/>
            </VBox.margin>
        </Label>
        <TextField fx:id="benutzername" promptText="z. B. m.alharethi"/>

        <Label text="Passwort" styleClass="feldname">
            <VBox.margin>
                <Insets top="6"/>
            </VBox.margin>
        </Label>
        <!-- Enter in beiden Feldern löst den Standardknopf "Anmelden" aus -->
        <PasswordField fx:id="passwort"/>

        <Label fx:id="meldung" styleClass="fehlermeldung" wrapText="true" minHeight="36"/>

        <Button fx:id="anmeldenKnopf" text="Anmelden" styleClass="primaer" defaultButton="true"
                maxWidth="Infinity" onAction="#anmelden"/>
    </VBox>
</StackPane>

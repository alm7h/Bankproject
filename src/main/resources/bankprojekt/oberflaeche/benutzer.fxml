<?xml version="1.0" encoding="UTF-8"?>

<!-- Benutzerverwaltung: Mitarbeiterzugänge anlegen, bearbeiten,
     Passwort zurücksetzen, deaktivieren und wieder aktivieren. -->

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="bankprojekt.oberflaeche.BenutzerController"
      stylesheets="@verwaltung.css"
      styleClass="arbeitsbereich">

    <Label text="Benutzer" styleClass="ueberschrift"/>

    <HBox styleClass="werkzeugleiste">
        <Label text="Mitarbeiterzugänge für die Bankverwaltung" styleClass="hinweis"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Neuer Benutzer" styleClass="primaer" onAction="#neuerBenutzer"/>
        <Button fx:id="bearbeitenKnopf" text="Bearbeiten" onAction="#bearbeiten"/>
        <Button fx:id="passwortKnopf" text="Passwort zurücksetzen" onAction="#passwortZuruecksetzen"/>
        <Button fx:id="statusKnopf" text="Deaktivieren" onAction="#statusWechseln"/>
    </HBox>

    <TableView fx:id="tabelle" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="nameSpalte" text="Benutzername" prefWidth="180"/>
            <TableColumn fx:id="anzeigeSpalte" text="Anzeigename" prefWidth="200"/>
            <TableColumn fx:id="statusSpalte" text="Status" prefWidth="110"/>
            <TableColumn fx:id="angelegtSpalte" text="Angelegt am" prefWidth="160"/>
            <TableColumn fx:id="anmeldungSpalte" text="Letzte Anmeldung" prefWidth="160"/>
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
        </columnResizePolicy>
    </TableView>

    <Label fx:id="anzahl" styleClass="fusszeile"/>
</VBox>

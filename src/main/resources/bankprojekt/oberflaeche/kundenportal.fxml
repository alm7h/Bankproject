<?xml version="1.0" encoding="UTF-8"?>

<!-- Hauptfenster des Kundenportals: Seitenleiste mit Navigation und Abmelden, oben die
     Begrüßung, darunter die jeweilige Ansicht. -->

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="bankprojekt.oberflaeche.KundenportalController"
            stylesheets="@verwaltung.css">

    <fx:define>
        <ToggleGroup fx:id="navigation"/>
    </fx:define>

    <left>
        <VBox styleClass="seitenleiste">
            <Label text="Kundenportal" styleClass="marke"/>
            <ToggleButton fx:id="kontenKnopf" text="Meine Konten" styleClass="navigation"
                          toggleGroup="$navigation" onAction="#kontenZeigen"/>
            <ToggleButton fx:id="antraegeKnopf" text="Anträge" styleClass="navigation"
                          toggleGroup="$navigation" onAction="#antraegeZeigen"/>
            <ToggleButton fx:id="datenKnopf" text="Meine Daten" styleClass="navigation"
                          toggleGroup="$navigation" onAction="#datenZeigen"/>

            <Region VBox.vgrow="ALWAYS"/>

            <Label fx:id="angemeldetAls" styleClass="benutzerinfo"/>
            <Button fx:id="abmeldenKnopf" text="Abmelden" styleClass="abmelden" maxWidth="Infinity"
                    onAction="#abmelden">
                <VBox.margin>
                    <Insets top="6" right="20" left="20"/>
                </VBox.margin>
            </Button>
        </VBox>
    </left>

    <center>
        <VBox>
            <VBox spacing="2">
                <padding>
                    <Insets top="20" right="24" left="24"/>
                </padding>
                <Label fx:id="begruessung" styleClass="begruessung"/>
                <Label fx:id="unterzeile" styleClass="untertitel" wrapText="true"/>
            </VBox>
            <StackPane fx:id="inhalt" VBox.vgrow="ALWAYS"/>
        </VBox>
    </center>
</BorderPane>

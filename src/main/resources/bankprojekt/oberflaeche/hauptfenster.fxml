<?xml version="1.0" encoding="UTF-8"?>

<!-- Hauptfenster der Bankverwaltung: Seitenleiste mit Navigation und Abmelden,
     rechts der Arbeitsbereich, in den die jeweilige Ansicht geladen wird. -->

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="bankprojekt.oberflaeche.HauptfensterController"
            stylesheets="@verwaltung.css">

    <fx:define>
        <ToggleGroup fx:id="navigation"/>
    </fx:define>

    <left>
        <VBox styleClass="seitenleiste">
            <Label text="Bankverwaltung" styleClass="marke"/>
            <ToggleButton fx:id="kundenKnopf" text="Kunden" styleClass="navigation"
                          toggleGroup="$navigation" onAction="#kundenZeigen"/>
            <ToggleButton fx:id="kontenKnopf" text="Konten" styleClass="navigation"
                          toggleGroup="$navigation" onAction="#kontenZeigen"/>
            <ToggleButton fx:id="antraegeKnopf" text="Anträge" styleClass="navigation"
                          toggleGroup="$navigation" onAction="#antraegeZeigen"/>
            <ToggleButton fx:id="benutzerKnopf" text="Benutzer" styleClass="navigation"
                          toggleGroup="$navigation" onAction="#benutzerZeigen"/>
            <ToggleButton fx:id="protokollKnopf" text="Protokoll" styleClass="navigation"
                          toggleGroup="$navigation" onAction="#protokollZeigen"/>

            <Region VBox.vgrow="ALWAYS"/>

            <Label fx:id="angemeldetAls" styleClass="benutzerinfo"/>
            <Button fx:id="abmeldenKnopf" text="Abmelden" styleClass="abmelden" maxWidth="Infinity"
                    onAction="#abmelden">
                <VBox.margin>
                    <Insets top="6" right="20" left="20"/>
                </VBox.margin>
            </Button>
        </VBox>
    </left>

    <center>
        <StackPane fx:id="inhalt"/>
    </center>
</BorderPane>

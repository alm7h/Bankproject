<?xml version="1.0" encoding="UTF-8"?>

<!-- Verwaltung, "Anträge": Kontoanträge aus dem Kundenportal prüfen, genehmigen oder
     mit Begründung ablehnen. -->

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="bankprojekt.oberflaeche.AntraegeController"
      stylesheets="@verwaltung.css"
      styleClass="arbeitsbereich">

    <Label text="Anträge" styleClass="ueberschrift"/>

    <HBox styleClass="werkzeugleiste">
        <Label text="Status" styleClass="feldname"/>
        <ComboBox fx:id="statusFilter" prefWidth="150"/>
    </HBox>

    <HBox spacing="12" VBox.vgrow="ALWAYS">
        <TableView fx:id="tabelle" HBox.hgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="nummerSpalte" text="Antrag" prefWidth="90"/>
                <TableColumn fx:id="eingereichtSpalte" text="Eingereicht" prefWidth="150"/>
                <TableColumn fx:id="artSpalte" text="Art" prefWidth="120"/>
                <TableColumn fx:id="antragstellerSpalte" text="Antragsteller" prefWidth="170"/>
                <TableColumn fx:id="kontoartSpalte" text="Kontoart" prefWidth="110"/>
                <TableColumn fx:id="waehrungSpalte" text="Währung" prefWidth="80"/>
                <TableColumn fx:id="statusSpalte" text="Status" prefWidth="100"/>
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
            </columnResizePolicy>
            <placeholder>
                <Label text="Keine Anträge."/>
            </placeholder>
        </TableView>

        <VBox styleClass="detail" prefWidth="340" minWidth="300">
            <Label text="Antrag" styleClass="detail-titel"/>
            <Label fx:id="keineAuswahl" text="Bitte links einen Antrag auswählen." styleClass="hinweis"/>
            <VBox fx:id="detailInhalt" spacing="10">
                <Label fx:id="details" wrapText="true"/>
                <HBox spacing="8">
                    <Button fx:id="genehmigenKnopf" text="Genehmigen" styleClass="primaer" onAction="#genehmigen"/>
                    <Button fx:id="ablehnenKnopf" text="Ablehnen" styleClass="gefahr" onAction="#ablehnen"/>
                </HBox>
            </VBox>
        </VBox>
    </HBox>

    <Label fx:id="anzahl" styleClass="fusszeile"/>
</VBox>

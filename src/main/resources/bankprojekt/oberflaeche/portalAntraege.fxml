<?xml version="1.0" encoding="UTF-8"?>

<!-- Kundenportal, "Anträge": Stand der eigenen Kontoanträge, weiteres Konto bzw. neuen
     Antrag stellen. -->

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="bankprojekt.oberflaeche.PortalAntraegeController"
      stylesheets="@verwaltung.css"
      styleClass="arbeitsbereich">

    <Label text="Meine Anträge" styleClass="ueberschrift"/>
    <Label fx:id="hinweis" styleClass="hinweis" wrapText="true"/>

    <HBox styleClass="werkzeugleiste">
        <Button fx:id="zusatzKnopf" text="Weiteres Konto beantragen" styleClass="primaer"
                onAction="#zusatzkontoBeantragen"/>
        <Button fx:id="erneutKnopf" text="Neuen Antrag stellen" styleClass="primaer"
                onAction="#erneutBeantragen"/>
    </HBox>

    <TableView fx:id="antragTabelle" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="nummerSpalte" text="Antrag" prefWidth="90"/>
            <TableColumn fx:id="artSpalte" text="Art" prefWidth="120"/>
            <TableColumn fx:id="kontoartSpalte" text="Kontoart" prefWidth="120"/>
            <TableColumn fx:id="waehrungSpalte" text="Währung" prefWidth="80"/>
            <TableColumn fx:id="eingereichtSpalte" text="Eingereicht" prefWidth="150"/>
            <TableColumn fx:id="statusSpalte" text="Status" prefWidth="100"/>
            <TableColumn fx:id="bemerkungSpalte" text="Bemerkung" prefWidth="320"/>
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
        </columnResizePolicy>
        <placeholder>
            <Label text="Noch keine Anträge."/>
        </placeholder>
    </TableView>
</VBox>
